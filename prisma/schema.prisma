generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Dock {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  bookings  Booking[]
}

model SlotConfig {
  id              Int      @id @default(autoincrement())
  openingTime     String
  closingTime     String
  slotDuration    Int      @default(30)
  bufferMinutes   Int      @default(0)
  workdays        String   @default("[1,2,3,4,5]")
  updatedAt       DateTime @updatedAt
}

model Booking {
  id             Int           @id @default(autoincrement())
  dockId         Int
  dock           Dock          @relation(fields: [dockId], references: [id])
  date           String
  slotStart      String
  slotEnd        String
  status         BookingStatus @default(GEBUCHT)
  speditionName  String
  kennzeichen    String
  referenz       String?
  kontaktName    String
  kontaktTelefon String
  warenart       String
  anzahlPaletten Int
  bemerkung      String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@unique([dockId, date, slotStart])
}

enum BookingStatus {
  GEBUCHT
  EINGETROFFEN
  IN_ABFERTIGUNG
  ABGESCHLOSSEN
  STORNIERT
}
